+static void mmvq_prefetch_init() {
+    static const bool done = [] {
+        const char * env = getenv("GGML_CUDA_MMVQ_PREFETCH");
+        const int    on  = env == nullptr ? 1 : atoi(env);
+        if (ggml_cuda_info().devices[ggml_cuda_get_device()].cc == GGML_CUDA_CC_DGX_SPARK) {
+            CUDA_CHECK(cudaMemcpyToSymbol(mmvq_pf_enabled_dev, &on, sizeof(on)));
+        }
+        return true;
+    }();
+    GGML_UNUSED(done);
+}

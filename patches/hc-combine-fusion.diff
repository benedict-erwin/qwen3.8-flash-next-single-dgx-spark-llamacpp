+#pragma once
+
+#include "common.cuh"
+
+// Fused tail of qwen4exp's build_hc_mix(): the sigmoid gate, the gating multiply, the sum of
+// the hc streams and the 1/hc scale in one pass.
+//
+//   dst[e, t] = s * ( sum_{c=0}^{hc-1} xn[e, c, t] * sigmoid(g[e, c, t]) ) + b
+//
+// xn, g: [ne0*hc, nt] f32 contiguous (xn is the normed residual, g the gate logits),
+// dst: [ne0, nt] f32 contiguous. Replaces UNARY(sigmoid)+MUL, CONT, hc-1 ADDs and SCALE,
+// and never materialises the [ne0, hc, nt] gated tensor. Roundings match the unfused chain:
+// one product per element, the adds in stream order, the scale as fma like scale_f32.
+void ggml_cuda_op_hc_mix_tail_fused(ggml_backend_cuda_context & ctx,
+                                    const ggml_tensor * xn,
+                                    const ggml_tensor * g,
+                                    int64_t ne0, int64_t hc, int64_t nt,
+                                    float s, float b,
+                                    ggml_tensor * dst);

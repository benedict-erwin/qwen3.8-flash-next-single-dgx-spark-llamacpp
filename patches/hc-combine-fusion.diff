diff --git a/ggml/src/ggml-cuda/hc-combine.cu b/ggml/src/ggml-cuda/hc-combine.cu
new file mode 100644
index 000000000..3b8daaa57
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-combine.cu
@@ -0,0 +1,81 @@
+#include "hc-combine.cuh"
+
+// One thread per float4 of the residual; e runs fastest, then the stream s, then the token t.
+// The gate is one scalar per (s, t), recomputed per thread: two FLOPs against 32 bytes of traffic.
+template <bool vec4>
+static __global__ void hc_combine_f32(const float * __restrict__ res,
+                                      const float * __restrict__ blk,
+                                      const float * __restrict__ inj,
+                                      float * __restrict__ dst,
+                                      const int64_t ne0, const int64_t hc, const int64_t n,
+                                      const float s1, const float b1, const float s2, const float b2) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+
+    const int64_t idx = vec4 ? i * 4 : i;
+    const int64_t e   = idx % ne0;
+    const int64_t st  = idx / ne0;          // s + hc * t
+    const int64_t t   = st / hc;
+
+    // Same roundings as the unfused chain, so greedy output stays bit-identical:
+    // scale_f32 is `scale*x + bias` (contracted to an fma by nvcc), op_sigmoid is
+    // 1/(1+expf(-x)), then op_mul and op_add round separately -- no fma there.
+    const float g   = inj[st];
+    const float sig = 1.0f / (1.0f + expf(-fmaf(s1, g, b1)));
+    const float w   = fmaf(s2, sig, b2);
+
+    if constexpr (vec4) {
+        const float4 r = *(const float4 *) (res + idx);
+        const float4 b = *(const float4 *) (blk + t * ne0 + e);
+        float4 o;
+        o.x = __fadd_rn(r.x, __fmul_rn(b.x, w));
+        o.y = __fadd_rn(r.y, __fmul_rn(b.y, w));
+        o.z = __fadd_rn(r.z, __fmul_rn(b.z, w));
+        o.w = __fadd_rn(r.w, __fmul_rn(b.w, w));
+        *(float4 *) (dst + idx) = o;
+    } else {
+        dst[idx] = __fadd_rn(res[idx], __fmul_rn(blk[t * ne0 + e], w));
+    }
+}
+
+void ggml_cuda_op_hc_combine_fused(ggml_backend_cuda_context & ctx,
+                                   const ggml_tensor * res,
+                                   const ggml_tensor * blk,
+                                   const ggml_tensor * inj,
+                                   float s1, float b1, float s2, float b2,
+                                   ggml_tensor * dst) {
+    GGML_ASSERT(res->type == GGML_TYPE_F32 && blk->type == GGML_TYPE_F32 &&
+                inj->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(res) && ggml_is_contiguous(blk) &&
+                ggml_is_contiguous(inj) && ggml_is_contiguous(dst));
+
+    const int64_t ne0 = res->ne[0];
+    const int64_t hc  = res->ne[1];
+    const int64_t nt  = res->ne[2] * res->ne[3];
+    GGML_ASSERT(ggml_nelements(blk) == ne0 * nt);
+    GGML_ASSERT(ggml_nelements(inj) == hc * nt);
+    GGML_ASSERT(ggml_nelements(dst) == ne0 * hc * nt);
+
+    const float * res_d = (const float *) res->data;
+    const float * blk_d = (const float *) blk->data;
+    const float * inj_d = (const float *) inj->data;
+    float *       dst_d = (float *) dst->data;
+
+    cudaStream_t stream = ctx.stream();
+    const int block_size = 256;
+
+    // float4 needs 16-byte alignment of every row start: ne0 % 4 == 0 covers res/dst/blk rows
+    const bool vec4 = ne0 % 4 == 0 && ((uintptr_t) res_d % 16 == 0) && ((uintptr_t) blk_d % 16 == 0) &&
+                      ((uintptr_t) dst_d % 16 == 0);
+    if (vec4) {
+        const int64_t n = ne0 * hc * nt / 4;
+        const int64_t grid = (n + block_size - 1) / block_size;
+        hc_combine_f32<true><<<grid, block_size, 0, stream>>>(res_d, blk_d, inj_d, dst_d, ne0, hc, n, s1, b1, s2, b2);
+    } else {
+        const int64_t n = ne0 * hc * nt;
+        const int64_t grid = (n + block_size - 1) / block_size;
+        hc_combine_f32<false><<<grid, block_size, 0, stream>>>(res_d, blk_d, inj_d, dst_d, ne0, hc, n, s1, b1, s2, b2);
+    }
+}
diff --git a/ggml/src/ggml-cuda/hc-combine.cuh b/ggml/src/ggml-cuda/hc-combine.cuh
new file mode 100644
index 000000000..e50267a2b
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-combine.cuh
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "common.cuh"
+
+// Fused hyper-connection combine, the tail of qwen4exp's build_hc_combine():
+//
+//   dst[e, s, t] = res[e, s, t] + (s2 * sigmoid(s1 * inj[s, t] + b1) + b2) * blk[e, t]
+//
+// res/dst: [ne0, hc, nt] f32 contiguous (dst may alias res), blk: ne0*nt f32 contiguous,
+// inj: hc*nt f32 contiguous. Replaces REPEAT, SCALE, UNARY(sigmoid), SCALE, MUL and ADD,
+// i.e. four passes over the residual become one read and one write of it.
+void ggml_cuda_op_hc_combine_fused(ggml_backend_cuda_context & ctx,
+                                   const ggml_tensor * res,
+                                   const ggml_tensor * blk,
+                                   const ggml_tensor * inj,
+                                   float s1, float b1, float s2, float b2,
+                                   ggml_tensor * dst);
diff --git a/ggml/src/ggml-cuda/hc-mix.cu b/ggml/src/ggml-cuda/hc-mix.cu
new file mode 100644
index 000000000..8a5eed5cc
--- /dev/null
+++ b/ggml/src/ggml-cuda/hc-mix.cu
@@ -0,0 +1,86 @@
+#include "hc-mix.cuh"
+
+static __device__ __forceinline__ float hc_sigmoid(float x) {
+    return 1.0f / (1.0f + expf(-x));   // op_sigmoid in unary.cu
+}
+
+// One thread per float4 of the output row; e runs fastest, then the token t.
+template <bool vec4>
+static __global__ void hc_mix_tail_f32(const float * __restrict__ xn,
+                                       const float * __restrict__ g,
+                                       float * __restrict__ dst,
+                                       const int64_t ne0, const int64_t hc, const int64_t n,
+                                       const float s, const float b) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) {
+        return;
+    }
+
+    const int64_t idx = vec4 ? i * 4 : i;
+    const int64_t e   = idx % ne0;
+    const int64_t t   = idx / ne0;
+    const int64_t row = t * hc * ne0 + e;   // stream 0 of token t
+
+    if constexpr (vec4) {
+        float4 acc;
+        {
+            const float4 x = *(const float4 *) (xn + row);
+            const float4 l = *(const float4 *) (g  + row);
+            acc.x = __fmul_rn(x.x, hc_sigmoid(l.x));
+            acc.y = __fmul_rn(x.y, hc_sigmoid(l.y));
+            acc.z = __fmul_rn(x.z, hc_sigmoid(l.z));
+            acc.w = __fmul_rn(x.w, hc_sigmoid(l.w));
+        }
+        for (int64_t c = 1; c < hc; ++c) {
+            const float4 x = *(const float4 *) (xn + row + c * ne0);
+            const float4 l = *(const float4 *) (g  + row + c * ne0);
+            acc.x = __fadd_rn(acc.x, __fmul_rn(x.x, hc_sigmoid(l.x)));
+            acc.y = __fadd_rn(acc.y, __fmul_rn(x.y, hc_sigmoid(l.y)));
+            acc.z = __fadd_rn(acc.z, __fmul_rn(x.z, hc_sigmoid(l.z)));
+            acc.w = __fadd_rn(acc.w, __fmul_rn(x.w, hc_sigmoid(l.w)));
+        }
+        float4 o;
+        o.x = fmaf(s, acc.x, b);
+        o.y = fmaf(s, acc.y, b);
+        o.z = fmaf(s, acc.z, b);
+        o.w = fmaf(s, acc.w, b);
+        *(float4 *) (dst + idx) = o;
+    } else {
+        float acc = __fmul_rn(xn[row], hc_sigmoid(g[row]));
+        for (int64_t c = 1; c < hc; ++c) {
+            acc = __fadd_rn(acc, __fmul_rn(xn[row + c * ne0], hc_sigmoid(g[row + c * ne0])));
+        }
+        dst[idx] = fmaf(s, acc, b);
+    }
+}
+
+void ggml_cuda_op_hc_mix_tail_fused(ggml_backend_cuda_context & ctx,
+                                    const ggml_tensor * xn,
+                                    const ggml_tensor * g,
+                                    int64_t ne0, int64_t hc, int64_t nt,
+                                    float s, float b,
+                                    ggml_tensor * dst) {
+    GGML_ASSERT(xn->type == GGML_TYPE_F32 && g->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(xn) && ggml_is_contiguous(g) && ggml_is_contiguous(dst));
+    GGML_ASSERT(ggml_nelements(xn) == ne0 * hc * nt && ggml_nelements(g) == ne0 * hc * nt);
+    GGML_ASSERT(ggml_nelements(dst) == ne0 * nt);
+
+    const float * xn_d  = (const float *) xn->data;
+    const float * g_d   = (const float *) g->data;
+    float *       dst_d = (float *) dst->data;
+
+    cudaStream_t stream = ctx.stream();
+    const int block_size = 256;
+
+    const bool vec4 = ne0 % 4 == 0 && ((uintptr_t) xn_d % 16 == 0) && ((uintptr_t) g_d % 16 == 0) &&
+                      ((uintptr_t) dst_d % 16 == 0);
+    if (vec4) {
+        const int64_t n = ne0 * nt / 4;
+        const int64_t grid = (n + block_size - 1) / block_size;
+        hc_mix_tail_f32<true><<<grid, block_size, 0, stream>>>(xn_d, g_d, dst_d, ne0, hc, n, s, b);
+    } else {
+        const int64_t n = ne0 * nt;
+        const int64_t grid = (n + block_size - 1) / block_size;
+        hc_mix_tail_f32<false><<<grid, block_size, 0, stream>>>(xn_d, g_d, dst_d, ne0, hc, n, s, b);
+    }
+}

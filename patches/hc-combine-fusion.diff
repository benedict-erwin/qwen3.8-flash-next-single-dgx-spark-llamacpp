+struct test_hc_combine : public test_case {
+    const int64_t ne0;
+    const int64_t hc;
+    const int64_t nt;
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "HC_COMBINE";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    std::string vars() override {
+        return VARS_TO_STR3(ne0, hc, nt);
+    }
+
+    test_hc_combine(int64_t ne0 = 2560, int64_t hc = 4, int64_t nt = 7)
+        : ne0(ne0), hc(hc), nt(nt) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * res = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, ne0, hc, nt);
+        ggml_tensor * blk = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ne0, nt);
+        ggml_tensor * inj = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, hc, nt);
+        ggml_set_name(res, "res");
+        ggml_set_name(blk, "blk");
+        ggml_set_name(inj, "inj");
+
+        ggml_tensor * w = ggml_sigmoid(ctx, ggml_scale(ctx, inj, 1.0f / (float) hc));
+        w = ggml_scale(ctx, w, 2.0f);
+        w = ggml_reshape_3d(ctx, w, 1, hc, nt);
+
+        ggml_tensor * b = ggml_reshape_3d(ctx, blk, ne0, 1, nt);
+        b = ggml_repeat_4d(ctx, b, ne0, hc, nt, 1);
+
+        ggml_tensor * out = ggml_add(ctx, res, ggml_mul(ctx, b, w));
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            init_tensor_uniform(t, -4.f, 4.f);
+        }
+    }
+};
